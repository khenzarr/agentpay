# Arc Testnet RPC (optional override)
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network

# Demo agent wallet — replace with your agent test wallet
NEXT_PUBLIC_DEMO_AGENT_ADDRESS=0x9c90f57b4D7DA490798AdBCA69bD878E9A10ACBC

# Demo client/evaluator wallet (optional override for identity mapping)
NEXT_PUBLIC_DEMO_CLIENT_ADDRESS=0xCdc3735BCC1DE14c48704859715F835d0A5a7168

# Optional demo identity label (e.g., analyst-agent.arc)
NEXT_PUBLIC_DEMO_AGENT_NAME=

# Optional ArcNS name for demo resolution (e.g., analyst-agent.arc)
NEXT_PUBLIC_DEMO_AGENT_ARCNS_NAME=

# Optional ArcNS primary name for client/evaluator identity (e.g., your-client.arc)
NEXT_PUBLIC_DEMO_CLIENT_ARCNS_NAME=

# Optional: override client-side indexing start block for ERC-8183 JobCreated scans
NEXT_PUBLIC_ERC8183_INDEXING_FROM_BLOCK=

# Optional: override client-side indexing end block for a fixed demo window
NEXT_PUBLIC_ERC8183_INDEXING_TO_BLOCK=

# Optional WalletConnect (not required for MetaMask MVP)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# App Kit Send (local script utility)
# Keep APPKIT_DRY_RUN=true to estimate only and avoid sending transactions.
APPKIT_PRIVATE_KEY=
APPKIT_RECIPIENT_ADDRESS=
APPKIT_AMOUNT=1.00
APPKIT_DRY_RUN=true

# App Kit Bridge/CCTP local script only. Never commit real keys.
APPKIT_BRIDGE_PRIVATE_KEY=
APPKIT_BRIDGE_FROM_CHAIN=Ethereum_Sepolia
APPKIT_BRIDGE_TO_CHAIN=Arc_Testnet
APPKIT_BRIDGE_RECIPIENT_ADDRESS=
APPKIT_BRIDGE_AMOUNT=0.01
APPKIT_BRIDGE_TOKEN=USDC
APPKIT_BRIDGE_DRY_RUN=true
