# Arc Testnet RPC (optional override)
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network

# Demo agent wallet — replace with your agent test wallet
NEXT_PUBLIC_DEMO_AGENT_ADDRESS=0x9c90f57b4D7DA490798AdBCA69bD878E9A10ACBC

# Demo client/evaluator wallet (optional override for identity mapping)
NEXT_PUBLIC_DEMO_CLIENT_ADDRESS=0xCdc3735BCC1DE14c48704859715F835d0A5a7168

# Optional demo identity label (e.g., analyst-agent.arc)
NEXT_PUBLIC_DEMO_AGENT_NAME=

# Optional ArcNS name for demo resolution (e.g., analyst-agent.arc)
NEXT_PUBLIC_DEMO_AGENT_ARCNS_NAME=

# Optional ArcNS primary name for client/evaluator identity (e.g., your-client.arc)
NEXT_PUBLIC_DEMO_CLIENT_ARCNS_NAME=

# Optional: override client-side indexing start block for ERC-8183 JobCreated scans
NEXT_PUBLIC_ERC8183_INDEXING_FROM_BLOCK=

# Optional: override client-side indexing end block for a fixed demo window
NEXT_PUBLIC_ERC8183_INDEXING_TO_BLOCK=

# Optional WalletConnect (not required for MetaMask MVP)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# App Kit Send (local script utility)
# Keep APPKIT_DRY_RUN=true to estimate only and avoid sending transactions.
APPKIT_PRIVATE_KEY=
APPKIT_RECIPIENT_ADDRESS=
APPKIT_AMOUNT=1.00
APPKIT_DRY_RUN=true

# App Kit Bridge/CCTP local script only. Never commit real keys.
APPKIT_BRIDGE_PRIVATE_KEY=
APPKIT_BRIDGE_FROM_CHAIN=Ethereum_Sepolia
APPKIT_BRIDGE_TO_CHAIN=Arc_Testnet
APPKIT_BRIDGE_RECIPIENT_ADDRESS=
APPKIT_BRIDGE_AMOUNT=0.01
APPKIT_BRIDGE_TOKEN=USDC
APPKIT_BRIDGE_DRY_RUN=true

# App Kit Gateway / Unified Balance local scripts (dry-run/check first)
# Keep APPKIT_UB_DRY_RUN=true unless explicitly approved for live spend.
APPKIT_UB_PRIVATE_KEY=
APPKIT_UB_SOURCE_CHAINS=Ethereum_Sepolia
APPKIT_UB_DESTINATION_CHAIN=Arc_Testnet
APPKIT_UB_RECIPIENT_ADDRESS=
APPKIT_UB_AMOUNT=0.01
APPKIT_UB_TOKEN=USDC
APPKIT_UB_USE_FORWARDER=true
APPKIT_UB_DRY_RUN=true
APPKIT_UB_INCLUDE_PENDING=true

# App Kit Gateway / Unified Balance deposit local script (dry-run by default)
APPKIT_UB_DEPOSIT_PRIVATE_KEY=
APPKIT_UB_DEPOSIT_CHAIN=Ethereum_Sepolia
APPKIT_UB_DEPOSIT_AMOUNT=0.01
APPKIT_UB_DEPOSIT_TOKEN=USDC
APPKIT_UB_DEPOSIT_DRY_RUN=true
# Optional: deposit to another gateway account (uses depositFor)
APPKIT_UB_DEPOSIT_ACCOUNT=

# Circle Wallets / Developer-Controlled Wallets server-only placeholders.
# Never expose these in client code. Never use NEXT_PUBLIC_ prefix.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_TESTNET_BLOCKCHAIN=ARC-TESTNET
# Keep true by default. After any live proof run, set/restore to true to avoid accidental duplicate wallet creation.
CIRCLE_WALLETS_DRY_RUN=true
CIRCLE_SCA_WALLET_DRY_RUN=true
CIRCLE_SCA_WALLET_COUNT=1
CIRCLE_SCA_WALLET_ID=
CIRCLE_SCA_WALLET_ADDRESS=
CIRCLE_WALLET_SET_NAME=AgentPay Arc Testnet Wallet Set
CIRCLE_WALLET_ACCOUNT_TYPE=EOA
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
CIRCLE_WALLET_TRANSFER_DESTINATION=
CIRCLE_WALLET_TRANSFER_AMOUNT=0.001
CIRCLE_WALLET_TRANSFER_TOKEN_ID=
CIRCLE_WALLET_TRANSACTION_ID=
# Keep true by default. Live send requires explicit founder approval and setting false.
CIRCLE_WALLET_TRANSFER_DRY_RUN=true
CIRCLE_TOKEN_LOOKUP_BLOCKCHAIN=ARC-TESTNET
CIRCLE_TOKEN_LOOKUP_SYMBOL=USDC
CIRCLE_TOKEN_LOOKUP_TOKEN_ID=
CIRCLE_SIGN_MESSAGE=AgentPay Circle Wallets signing proof on ARC-TESTNET
# CIRCLE_ENTITY_SECRET_CIPHERTEXT=
# Optional and only needed for direct REST API paths.
# Not required for the official SDK quickstart flow used in this repo.

# Circle Gas Station / Paymaster readiness placeholders (server-only, optional for discovery)
CIRCLE_GAS_STATION_POLICY_ID=
CIRCLE_PAYMASTER_POLICY_ID=
CIRCLE_GASLESS_DRY_RUN=true

# Circle Paymaster sponsored transfer proof path (server-only, dry-run first)
CIRCLE_PAYMASTER_DRY_RUN=true
CIRCLE_PAYMASTER_VERSION=v0.8
CIRCLE_PAYMASTER_ADDRESS=0x3BA9A96eE3eFf3A69E2B18886AcF52027EFF8966
# Optional non-secret policy id (if available from Console)
CIRCLE_GAS_STATION_POLICY_ID=

# Raw ERC-4337 infra readiness (non-mutating discovery only)
ARC_BUNDLER_RPC_URL=
CIRCLE_PAYMASTER_SERVICE_URL=
RAW_ERC4337_ENTRYPOINT_VERSION=v0.8
RAW_ERC4337_ENTRYPOINT_ADDRESS=
RAW_ERC4337_DRY_RUN=true
