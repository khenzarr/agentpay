    "circle:wallets:sign-message": "tsx --env-file=.env.circle.local scripts/circle-wallets-sign-message.ts",
    "circle:wallets:send-tiny-transfer": "tsx --env-file=.env.circle.local scripts/circle-wallets-send-tiny-transfer.ts",
    "circle:wallets:token-lookup": "tsx --env-file=.env.circle.local scripts/circle-wallets-token-lookup.ts",
    "circle:wallets:list-balances": "tsx --env-file=.env.circle.local scripts/circle-wallets-list-balances.ts"
