{
  "name": "agentpay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18 <=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "appkit:send:arc:usdc": "tsx --env-file=.env.appkit.local scripts/appkit-send-arc-usdc.ts",
    "appkit:bridge:usdc:arc": "tsx --env-file=.env.appkit.local scripts/appkit-bridge-usdc-to-arc.ts",
    "appkit:ub:check": "tsx --env-file=.env.appkit.local scripts/appkit-unified-balance-check.ts",
    "appkit:ub:spend:arc": "tsx --env-file=.env.appkit.local scripts/appkit-unified-balance-spend-to-arc.ts",
    "appkit:ub:deposit": "tsx --env-file=.env.appkit.local scripts/appkit-unified-balance-deposit.ts",
    "circle:wallets:readiness": "tsx --env-file=.env.circle.local scripts/circle-wallets-readiness.ts",
    "circle:wallets:generate-entity-secret": "tsx scripts/circle-wallets-generate-entity-secret.ts",
    "circle:wallets:register-entity-secret": "tsx --env-file=.env.circle.local scripts/circle-wallets-register-entity-secret.ts",
    "circle:wallets:create:arc": "tsx --env-file=.env.circle.local scripts/circle-wallets-create-arc-wallet.ts",
